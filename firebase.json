{
  "hosting": {
    "target": "app",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*serviceAccount*.json",
      "**/*service-account*.json",
      "**/*firebase-adminsdk*.json",
      "**/*-firebase-adminsdk-*.json",
      "serviceAccountKey.json",
      "serviceAccountKey-new.json",
      "new-project-web-config.txt",
      "backup/**",
      "exports/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "skills-lock.json",
      "firestore.rules",
      "firestore.indexes.json",
      "*.js",
      "*.log",
      "*.md",
      "data/**",
      "functions/**"
    ],
    "rewrites": [
      {
        "source": "/api/chat",
        "function": {
          "functionId": "chat",
          "region": "asia-southeast1"
        }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5050
    },
    "ui": {
      "enabled": true,
      "port": 0
    },
    "singleProjectMode": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.local",
        "firebase-debug.log*"
      ]
    }
  ]
}
